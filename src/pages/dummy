- name: Deploy to local bc270 container
        shell: powershell
        run: |
          Import-Module BcContainerHelper
          $credential = New-Object PSCredential("Leilah", (ConvertTo-SecureString "${{ secrets.BC_PASSWORD }}" -AsPlainText -Force))

          $appFile = Get-ChildItem -Path "./output" -Filter *.app | Select-Object -First 1
          Write-Host "Deploying $($appFile.Name) to bc270"

          $ErrorActionPreference = "Stop"

          try {
            Publish-BcContainerApp `
              -containerName "bc270" `
              -credential $credential `
              -appFile $appFile.FullName `
              -skipVerification `
              -install `
              -sync `
              -syncMode ForceSync
            Write-Host "Published and installed successfully (fresh install)."
          } catch {
            if ($_.Exception.Message -match "already uses a different version") {
              Write-Host "A different version is already installed - retrying with -upgrade."
              Publish-BcContainerApp `
                -containerName "bc270" `
                -credential $credential `
                -appFile $appFile.FullName `
                -skipVerification `
                -install `
                -sync `
                -syncMode ForceSync `
                -upgrade
              Write-Host "Upgraded successfully."
            } elseif ($_.Exception.Message -match "already installed") {
              Write-Host "This exact version is already installed - nothing to do."
            } else {
              throw
            }
          }

          Write-Host "Deploy step completed."